[Version]
Signature = "$WINDOWS NT$"
Class = HIDClass
ClassGuid = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %ManufacturerName%
CatalogFile = FirstClickBluetooth.cat
DriverVer = 11/10/2026,2026.3982.4.1
PnpLockdown = 1

[DestinationDirs]
DriverFiles = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
AmtPtpHidFilter.sys = 1

[Manufacturer]
%ManufacturerName% = Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceDescription% = FirstClick_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0265&Col01
%AuxiliaryDescription% = FirstClick_Null,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0265&Col02
%DeviceDescription% = FirstClick_Install,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0324&Col01
%AuxiliaryDescription% = FirstClick_Null,HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0001004c_PID&0324&Col02

[FirstClick_Install.NT]
CopyFiles = DriverFiles
Include = MsHidKmdf.inf
Needs = MsHidKmdf.NT

[FirstClick_Install.NT.Services]
AddService = AmtPtpHidFilter,,FirstClick_Service
Include = MsHidKmdf.inf
Needs = MsHidKmdf.NT.Services

[FirstClick_Install.NT.HW]
AddReg = FirstClick_Hardware

[FirstClick_Install.NT.Wdf]
KmdfService = AmtPtpHidFilter,FirstClick_Framework

[FirstClick_Hardware]
HKR,,FriendlyName,,%DeviceDescription%
HKR,,LowerFilters,0x00010008,"AmtPtpHidFilter"

[FirstClick_Service]
DisplayName = %ServiceDescription%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\AmtPtpHidFilter.sys

[FirstClick_Framework]
KmdfLibraryVersion = 1.15

[FirstClick_Null]

[FirstClick_Null.Services]
AddService = ,2

[DriverFiles]
AmtPtpHidFilter.sys

[Strings]
ManufacturerName = "Local Magic Trackpad First Click"
DeviceDescription = "Magic Trackpad 2 First Click Pressure (Bluetooth)"
AuxiliaryDescription = "Apple Multi-touch Auxiliary Services"
ServiceDescription = "Magic Trackpad First Click Bluetooth Filter"
DiskName = "Magic Trackpad 2 First Click Pressure"
